# Environment variables for the project

# Qual provedor de LLM atende o /interrogate.
#   gemini -> API do Google Gemini (nuvem)   [padrao]
#   local  -> Ollama rodando na maquina
#   llamacpp -> GGUF carregado dentro da API (llama-cpp-python), sem daemon
#   mock   -> respostas deterministicas, sem rede (testes / demo offline)
# Mudar exige reiniciar o servidor: o provedor e instanciado uma vez so.
LLM_TYPE=gemini

# --- gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
# Opcional. Se ausente, usa models/gemini-2.5-flash.
# GEMINI_MODEL=models/gemini-2.5-flash

# --- local (ollama) ---
# Opcionais: so defina se fugir do padrao.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=detetive-guilty
# Segundos de espera pela inferencia local. Lembre que o ApiClient do Unity
# desiste em 90s, entao valores muito acima disso so trocam de qual lado o
# timeout acontece.
# OLLAMA_TIMEOUT=60

# --- llamacpp ---
# Requer: pip install -r requirements-llamacpp.txt
# Trocar de modelo = trocar o caminho. Relativo a raiz do projeto.
# LLAMA_CPP_MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf
# Precisa caber o prompt inteiro (caso + historico). Abaixo de 4096 o prompt
# estoura e a rota responde 503 pedindo para aumentar.
# LLAMA_CPP_N_CTX=4096
# 0 = so CPU. -1 ou auto = todas as camadas na GPU (precisa da lib com CUDA).
# LLAMA_CPP_N_GPU_LAYERS=0
# Padrao: nucleos fisicos (logicos / 2). Acima disso costuma ficar MAIS lento.
# LLAMA_CPP_N_THREADS=8
# LLAMA_CPP_MAX_TOKENS=512
# LLAMA_CPP_TEMPERATURE=0.7
